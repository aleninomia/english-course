            severity: 'MAJOR',
            status: 'OPEN',
          })
          .withIssue({
            ruleKey: 'java:S9999',
            message: 'Blocker issue',
            severity: 'BLOCKER',
            status: 'FIXED',
          })
          .withIssue({
            ruleKey: 'java:S9999',
            message: 'Blocker issue',
