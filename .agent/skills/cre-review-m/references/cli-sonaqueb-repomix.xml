export interface IssueConfig {
  key?: string;
  ruleKey: string;
  message: string;
  severity?: 'INFO' | 'MINOR' | 'MAJOR' | 'CRITICAL' | 'BLOCKER';
  component?: string;
  status?: string;
  type?: string;
  line?: number;
}

export interface SqaaIssueConfig {
