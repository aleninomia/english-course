    const spawnSpy = spyOn(processLib, 'spawnProcess').mockResolvedValue({
      exitCode: 128,
      stdout: '',
      stderr: 'fatal: not a git repository',
    });

    try {
      expect(resolveGitHooksDir(TEMP_DIR)).rejects.toThrow(
        'Could not resolve git hooks directory (exit code 128)',
      );
