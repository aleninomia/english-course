<script>
  // Theme toggle
  (function() {
    const btn = document.getElementById('themeToggle');
    if (document.documentElement.getAttribute('data-theme') === 'light') btn.textContent = '☾';
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
        btn.textContent = '☀';
        localStorage.setItem('clidoc-theme', 'dark');
        document.getElementById('wave-glow').style.background = 'radial-gradient(ellipse 70% 60% at 50% 100%, rgba(18,110,211,0.18) 0%, rgba(18,110,211,0.07) 45%, transparent 70%)';
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        btn.textContent = '☾';
        localStorage.setItem('clidoc-theme', 'light');
        document.getElementById('wave-glow').style.background = 'radial-gradient(ellipse 70% 60% at 50% 100%, rgba(18,110,211,0.10) 0%, rgba(18,110,211,0.04) 45%, transparent 70%)';
      }
    });
  })();

  // Inject version from data
  fetch('data/commands.json').then(r => r.json()).then(data => {
    document.getElementById('nav-version').textContent = 'v' + data.version;
    document.getElementById('meta-version').setAttribute('content', data.version);
  });

  // ─── Cycling terminal ───────────────────────────────────────────
  (function() {
    const C = { prompt: '#126ed3', cmd: '#d4d4d4', success: '#4ade80', muted: '#888', error: '#f87171', accent: '#60a5fa' };
    const CHAR_MS = 42, LINE_MS = 70, PAUSE_MS = 2800, FADE_MS = 350;
    const DEV_EMOJIS = [
      '👨🏻‍💻','👨🏼‍💻','👨🏽‍💻','👨🏽‍💻','👨🏾‍💻','👨🏿‍💻',
      '👩🏻‍💻','👩🏼‍💻','👩🏽‍💻','👩🏽‍💻','👩🏾‍💻',
      '🧑🏻‍💻','🧑🏼‍💻','🧑🏽‍💻','🧑🏽‍💻','🧑🏾‍💻',
    ];

    // Table helpers — mirrors the real formatTable() column widths
    const SW = 8, RW = 15, MW = 45;
    const tr = (sev, rule, msg, file, c) => ({
      t: `${sev.padEnd(SW)} | ${rule.padEnd(RW)} | ${msg.substring(0, MW).padEnd(MW)} | ${file}`,
      c,
    });
    const tsep = { t: `${'-'.repeat(SW)}-+-${'-'.repeat(RW)}-+-${'-'.repeat(MW)}-+-${'-'.repeat(16)}`, c: C.muted };

    const intents = [
      'list my project\'s open issues',
      'authenticate with SonarQube',
      'set up Claude Code integration',
      'analyze a file for issues',
      'scan for hardcoded secrets',
    ];

    const agentIntents = [
      'fetching open issues for my-org_app',
      'authenticating with sonarcloud.io',
      'setting up hooks and MCP server for Claude Code',
      'checking src/auth.ts for issues',
      'scanning src/ for hardcoded secrets',
    ];

    const flows = [
      [ // sonar list issues --format table
        { t: '$ sonar list issues --project my-org_app --format table', cmd: true },
        tr('SEVERITY', 'RULE', 'MESSAGE', 'FILE', C.muted),
        tsep,
        tr('BLOCKER',  'java:S2068', 'Hardcoded password detected',              'src/config.ts:12', C.error),
        tr('CRITICAL', 'java:S3649', 'SQL injection vulnerability',               'src/db.ts:34',     C.error),
        tr('MAJOR',    'java:S1764', 'Identical sub-expressions on both sides',   'src/auth.ts:78',   C.cmd  ),
        tr('MINOR',    'java:S1135', 'Complete the task associated to this TODO', 'src/utils.ts:5',   C.muted),
      ],
      [ // sonar auth login
        { t: '$ sonar auth login', cmd: true },
        { t: 'Authenticating with: sonarcloud.io',  c: C.muted },
        { t: '  ✓  Token received',                 c: C.success },
        { t: 'Using organization: my-org',           c: C.muted },
        { t: '✅ Authentication successful for: sonarcloud.io (my-org)', c: C.success },
      ],
      [ // sonar integrate claude
        { t: '$ sonar integrate claude', cmd: true },
        { t: 'Phase 1/3: Discovery & Validation',    c: C.muted },
        { t: 'Server: sonarcloud.io · Project: my-org_app', c: C.muted },
        { t: 'Phase 2/3: Health Check & Repair',     c: C.muted },
        { t: '✅ All checks passed! Configuration is healthy.', c: C.success },
        { t: 'Installing claude code hooks...',       c: C.muted },
        { t: '✅ Setup complete!',                   c: C.success },
      ],
      [ // sonar verify --file
        { t: '$ sonar verify --file src/auth.ts', cmd: true },
        { t: '' },
        { t: 'Running SonarQube Agentic Analysis analysis...',              c: C.muted },
        { t: '' },
        { t: '❌ SonarQube Agentic Analysis found 2 issues:',      c: C.error },
        { t: '' },
        { t: '  [1] SQL injection vulnerability (line 23)', c: C.cmd },
        { t: '      Rule: java:S3649',               c: C.muted },
        { t: '  [2] Hardcoded password detected (line 45)', c: C.cmd },
        { t: '      Rule: java:S2068',               c: C.muted },
      ],
      [ // sonar analyze secrets
        { t: '$ sonar analyze secrets src/', cmd: true },
        { t: '' },
        { t: '✅ Scan completed successfully',        c: C.success },
        { t: '  Duration: 312ms',                    c: C.muted },
        { t: '  No issues detected',                 c: C.muted },
      ],
    ];

    function line(text, color) {
      const el = document.createElement('span');
      el.style.cssText = 'display:block;white-space:nowrap;overflow:hidden;';
      if (color) el.style.color = color;
      el.textContent = text;
      return el;
    }

    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    async function typeLine(body, text, charMs) {
      const promptEl = document.createElement('span');
      promptEl.style.color = C.prompt;
      promptEl.textContent = '$ ';
      const cmdEl = document.createElement('span');
      cmdEl.style.color = C.cmd;
      const row = document.createElement('span');
      row.style.cssText = 'display:block;white-space:nowrap;overflow:hidden;';
      row.appendChild(promptEl);
      row.appendChild(cmdEl);
      body.appendChild(row);
      const content = text.slice(2);
      for (const ch of content) {
        cmdEl.textContent += ch;
        await sleep(charMs);
      }
    }

    async function revealLine(body, text, color) {
      const el = line(text, color);
      el.style.width = '0';
      el.style.transition = `width ${Math.max(80, text.length * 6)}ms steps(${Math.max(1, text.length)}, end)`;
      body.appendChild(el);
      await sleep(20);
      el.style.width = '100%';
      await sleep(Math.max(80, text.length * 6));
    }

    async function runFlow(body, flow) {
      for (const item of flow) {
        if (item.cmd) {
          await typeLine(body, item.t, CHAR_MS);
        } else if (item.t === '') {
          body.appendChild(line('', item.c));
        } else {
          await revealLine(body, item.t, item.c);
        }
        await sleep(LINE_MS);
      }
    }

    async function typeEl(id, text, charMs) {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = '';
      for (const ch of text) {
        el.textContent += ch;
        await sleep(charMs);
      }
    }

    const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%&*?/\\';
    function randGlyph() { return GLYPHS[Math.floor(Math.random() * GLYPHS.length)]; }
    async function scrambleEl(id, text) {
      const el = document.getElementById(id);
      if (!el) return;
      const words = text.split(' ');
      let settled = '';
      for (let w = 0; w < words.length; w++) {
        const word = words[w];
        const TICK = 16, SETTLE_EVERY = 1;
        let tick = 0, s = 0;
        await new Promise(resolve => {
          const interval = setInterval(() => {
            if (s >= word.length) {
              settled += (w > 0 ? ' ' : '') + word;
              el.textContent = settled;
              clearInterval(interval);
              resolve();
              return;
            }
            const scrambled = Array.from({ length: word.length - s }, () => randGlyph()).join('');
            el.textContent = settled + (w > 0 ? ' ' : '') + word.slice(0, s) + scrambled;
            tick++;
            if (tick % SETTLE_EVERY === 0) s++;
          }, TICK);
        });
        await sleep(40);
      }
    }

    async function typeIntent(i) {
      await Promise.all([
        typeEl('terminal-intent-text', intents[i], CHAR_MS - 10),
        scrambleEl('terminal-agent-text', agentIntents[i]),
      ]);
    }

    function clearIntent() {
      ['terminal-intent-text', 'terminal-agent-text'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = '';
      });
    }

    async function cycle() {
      const body = document.getElementById('terminal-body');
      if (!body) return;
      let i = 0;
      while (true) {
        body.innerHTML = '';
        body.style.opacity = '1';
        const emojiEl = document.getElementById('dev-emoji');
        if (emojiEl) emojiEl.textContent = DEV_EMOJIS[Math.floor(Math.random() * DEV_EMOJIS.length)];
        await typeIntent(i);
        await runFlow(body, flows[i]);
        await sleep(PAUSE_MS);
        body.style.opacity = '0';
        clearIntent();
        await sleep(FADE_MS);
        i = (i + 1) % flows.length;
      }
    }

    cycle();
  })();
  // ────────────────────────────────────────────────────────────────

  function showHeroTab(name, btn) {
    document.querySelectorAll('#hero-tab-linux, #hero-tab-windows').forEach(p => p.classList.remove('active'));
    btn.closest('.tab-group').querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('hero-tab-' + name).classList.add('active');
    btn.classList.add('active');
  }

  function showTab(name) {
    const section = document.getElementById('install');
    section.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    section.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    event.target.classList.add('active');
  }

  const JTBD_RECIPES = {
    claude: [
      { title: 'Authenticate',        cmd: 'sonar auth login',         desc: 'Connect to SonarQube Cloud or your self-hosted server.' },
      { title: 'Integrate Claude',    cmd: 'sonar integrate claude',   desc: 'Installs hooks and MCP server for your project.' },
    ],
    'secrets-scan': [
      { title: 'Authenticate',        cmd: 'sonar auth login',                               desc: 'Connect to SonarQube Cloud or your self-hosted server.' },
      { title: 'Scan a file',         cmd: 'sonar analyze secrets &lt;file&gt;',             desc: 'Detects hardcoded API keys, tokens, and credentials.' },
    ],
    issues: [
      { title: 'Authenticate',        cmd: 'sonar auth login',                                        desc: 'Connect to SonarQube.' },
      { title: 'List issues',         cmd: 'sonar list issues --project &lt;key&gt;',                 desc: 'Returns issues in JSON by default.' },
      { title: 'Filter &amp; format', cmd: 'sonar list issues --project &lt;key&gt; --severity CRITICAL --format table', desc: 'Narrow by severity and output as a table.' },
    ],
    analyze: [
      { title: 'Authenticate',        cmd: 'sonar auth login',                                              desc: 'Connect to SonarQube.' },
      { title: 'Analyze',             cmd: 'sonar verify --file &lt;file&gt; --project &lt;key&gt;',       desc: 'Runs server-side static analysis on a file (SonarQube Cloud only).' },
    ],
    hooks: [
      { title: 'Authenticate',        cmd: 'sonar auth login',                           desc: 'Connect to SonarQube.' },
      { title: 'Install hook',        cmd: 'sonar integrate git',                        desc: 'Runs a secrets scan before every git commit or push.' },
    ],
    'pr-issues': [
      { title: 'Authenticate',        cmd: 'sonar auth login',                                                              desc: 'Connect to SonarQube.' },
      { title: 'List PR issues',      cmd: 'sonar list issues --project &lt;key&gt; --pull-request &lt;number&gt;',        desc: 'Shows only issues introduced in the pull request.' },
      { title: 'Format as table',     cmd: 'sonar list issues --project &lt;key&gt; --pull-request &lt;number&gt; --format table', desc: 'Human-readable table output.' },
    ],
    'list-projects': [
      { title: 'Authenticate',        cmd: 'sonar auth login',         desc: 'Connect to SonarQube Cloud or your self-hosted server.' },
      { title: 'List projects',       cmd: 'sonar list projects',      desc: 'Returns all projects you have access to.' },
    ],
    install: [
      { title: 'Check for updates',   cmd: 'sonar self-update --status',      desc: 'Check if a newer version is available without installing.' },
      { title: 'Update',              cmd: 'sonar self-update',               desc: 'Install the latest version of the CLI.' },
    ],
    status: [
      { title: 'Check status',        cmd: 'sonar auth status',   desc: 'Shows your current server and org connection.' },
      { title: 'Re-authenticate',     cmd: 'sonar auth login',    desc: 'Refresh credentials if expired.' },
    ],
  };

  function buildStepsHtml(steps) {
    return '<div class="steps">' + steps.map((s, i) => {
      const arrow = i < steps.length - 1 ? '<div class="steps-arrow">→</div>' : '';
      return `<div class="step"><div class="step-num">${i + 1}</div><h3>${s.title}</h3><code>${s.cmd}</code><p>${s.desc}</p></div>${arrow}`;
    }).join('') + '</div>';
  }

  let activeJtbd = null;

  function showJtbd(key) {
    const steps = JTBD_RECIPES[key];
    const box = document.getElementById('jtbd-recipe');
    const pills = document.querySelectorAll('.jtbd-pill');

    pills.forEach(p => p.classList.remove('active'));

    if (activeJtbd === key) {
      activeJtbd = null;
      box.classList.remove('visible');
      box.innerHTML = '';
      return;
    }

    activeJtbd = key;
    const activePill = document.querySelector(`.jtbd-pill[onclick="showJtbd('${key}')"]`);
    if (activePill) activePill.classList.add('active');
    box.innerHTML = buildStepsHtml(steps);
    box.classList.add('visible');
  }

  showJtbd('status');

  function copyInstall(btn) {
    const text = btn.closest('.code-block').querySelector('code').textContent;
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = 'Copied!';
      btn.classList.add('copied');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    });
  }

  // ─── Feedback popover trigger ─────────────────────────────────
  (function() {
    var fab = document.getElementById('feedbackFab');
    if (!fab) return;
    var triggered = false;
    function show() {
      if (triggered) return;
      triggered = true;
      fab.classList.add('open');
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('click', onClick);
    }
    function onScroll() {
      if (window.scrollY > 200) show();
    }
    function onClick(e) {
      if (!fab.contains(e.target)) show();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('click', onClick);
  })();

  // ─── ASCII Side-view Wave ────────────────────────────────────
  (function() {
    const canvas = document.getElementById('wave-bg');
    const ctx    = canvas.getContext('2d');

    const CELL_W = 14;
    const CELL_H = 20;

    // Characters for: surface crest, just-below, mid-water, deep
    const SURFACE = ['≈', '∿', '~', '∼', '≈', '∿'];
    const WATER   = ['~', '∼', '·', '·', ' ', ' '];

    // 1-D wave simulation along X (the surface height per column)
    let simN    = 200;
    let wCur    = new Float32Array(simN);
    let wPrev   = new Float32Array(simN);
    const DAMP  = 0.988;   // energy decay (higher = rings longer)
    const SPD   = 0.05;    // propagation speed

    // Water level: fraction of screen height where surface sits
    const WATER_LEVEL = 0.62;

    let renderCols, renderRows;
    function resize() {
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
      renderCols = Math.ceil(canvas.width  / CELL_W) + 2;
      renderRows = Math.ceil(canvas.height / CELL_H) + 2;
    }
    window.addEventListener('resize', resize);
    resize();

    // Mouse: push the surface up at the cursor's X column
    let lastMCol = -1;
    document.addEventListener('mousemove', e => {
      const col = Math.round((e.clientX / window.innerWidth) * (simN - 1));
      if (col === lastMCol) return;
      lastMCol = col;
      for (let dx = -4; dx <= 4; dx++) {
        const nx = col + dx;
        if (nx < 0 || nx >= simN) continue;
        wCur[nx] -= 0.03 * Math.exp(-dx * dx / 6); // negative = push surface up
      }
    });

    // Random ambient drip
    let tick = 0;
    function maybeDroplet() {
      if (++tick % 220 === 0) {
        const x = 3 + Math.floor(Math.random() * (simN - 6));
        wCur[x] += (0.3 + Math.random() * 0.35) * (Math.random() < 0.5 ? 1 : -1);
      }
    }

    // Seed gentle initial motion
    wCur[Math.floor(simN * 0.25)] = 0.4;
    wCur[Math.floor(simN * 0.65)] = -0.3;

    function stepWave() {
      const next = new Float32Array(simN);
      for (let x = 1; x < simN - 1; x++) {
        const lap = wCur[x - 1] + wCur[x + 1] - 2 * wCur[x];
        next[x] = (2 * wCur[x] - wPrev[x] + SPD * lap) * DAMP;
      }
      // Reflective boundaries
      next[0]       = next[1];
      next[simN - 1] = next[simN - 2];
      wPrev = wCur;
      wCur  = next;
    }

    // Slow background swell (sine) layered on top of simulation
    let t = 0;

    function getSurfaceRow(col) {
      const nx  = col / renderCols;
      const sim = wCur[Math.round(nx * (simN - 1))];
      // Background swell: two slow sine waves
      const swell =
        Math.sin(nx * Math.PI * 3.5 + t * 0.22) * 0.022 +
        Math.sin(nx * Math.PI * 6.0 - t * 0.14) * 0.012;
      return (WATER_LEVEL + swell + sim * 0.04) * renderRows;
    }

    function getColor() {
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      return isDark ? '#7dd3fc' : '#126ed3';
    }

    function draw() {
      maybeDroplet();
      stepWave();
      t += 0.003;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.font = `${CELL_H * 0.68}px 'SF Mono', 'Fira Code', monospace`;
      ctx.textBaseline = 'top';
      const color = getColor();

      for (let col = 0; col < renderCols; col++) {
        const surfRow = getSurfaceRow(col);

        for (let row = 0; row < renderRows; row++) {
          const depth = row - surfRow; // negative = above water

          if (depth < -0.5) continue; // above surface — empty

          let ch, alpha;

          if (depth < 1.2) {
            // Surface row: undulating crest characters
            const si = Math.floor(((Math.sin(col * 0.28 + t * 1.1) + 1) / 2) * SURFACE.length);
            ch    = SURFACE[Math.min(si, SURFACE.length - 1)];
            alpha = 0.32 + Math.abs(wCur[Math.round((col / renderCols) * (simN - 1))]) * 0.14;
          } else {
            // Below surface: sparse fill that fades with depth
            const depthFrac = Math.min((depth - 1) / 10, 1);
            if (depthFrac > 0.75) continue;

            const wi = Math.floor(depthFrac * WATER.length);
            ch = WATER[Math.min(wi, WATER.length - 1)];
            if (ch === ' ') continue;

            // Horizontal undulation in the body
            const bodyWave = (Math.sin(col * 0.35 + t * 0.5 + depth * 0.3) + 1) / 2;
            if (bodyWave < 0.45) continue; // keep it sparse

            alpha = (0.22 - depthFrac * 0.20) * bodyWave;
          }

          ctx.globalAlpha = Math.max(0, Math.min(alpha, 0.52));
          ctx.fillStyle   = color;
          ctx.fillText(ch, col * CELL_W, row * CELL_H);
        }
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(draw);
    }

    draw();
  })();
  // ─────────────────────────────────────────────────────────────
</script>
</body>
</html>
</file>

