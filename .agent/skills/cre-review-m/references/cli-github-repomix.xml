			lineLength: 10,
			values:     []string{},
			wants:      "",
		},
		{
			name:       "empty with indent",
			lineLength: 10,
			indent:     2,
			values:     []string{},
			wants:      "  ",
		},
		{
			name:       "single",
			lineLength: 10,
			values:     []string{"foo"},
			wants:      "foo",
		},
		{
			name:       "single with indent",
			lineLength: 10,
			indent:     2,
			values:     []string{"foo"},
			wants:      "  foo",
