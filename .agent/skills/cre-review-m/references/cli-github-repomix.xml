				"RUN_ID": "1",
			},
			expected: false,
		},
		// TODO: Figure out how to refactor IsTerminal() to be testable
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			os.Clearenv()
			for k, v := range tt.env {
				os.Setenv(k, v)
