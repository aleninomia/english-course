func TestGetWorkflows(t *testing.T) {
	tests := []struct {
		name              string
		repo              ghrepo.Interface
		limit             int
		httpStubs         func(*httpmock.Registry)
		expectedWorkflows []Workflow
		expectedError     error
	}{
