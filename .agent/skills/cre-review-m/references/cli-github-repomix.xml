			wants: "red",
			cs: &ColorScheme{
				Enabled:       true,
				EightBitColor: true,
				ColorLabels:   true,
			},
		},
	}

	for _, tt := range tests {
		output := tt.cs.Label(tt.hex, tt.text)
		assert.Equal(t, tt.wants, output)
	}
}

func TestTableHeader(t *testing.T) {
