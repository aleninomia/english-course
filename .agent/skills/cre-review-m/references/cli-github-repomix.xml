			want: expects{
				method:  "GET",
				u:       "https://api.github.com/repos/octocat/spoon-knife",
				body:    "",
				headers: "Accept: */*\r\n",
			},
		},
		{
			name: "GET with accept header",
			args: args{
				client:  &httpClient,
				host:    "github.com",
				method:  "GET",
				p:       "repos/octocat/spoon-knife",
				params:  nil,
				headers: []string{"Accept: testing"},
			},
			wantErr: false,
			want: expects{
				method:  "GET",
				u:       "https://api.github.com/repos/octocat/spoon-knife",
				body:    "",
				headers: "Accept: testing\r\n",
			},
		},
		{
			name: "lowercase HTTP method",
			args: args{
				client:  &httpClient,
				host:    "github.com",
				method:  "get",
				p:       "repos/octocat/spoon-knife",
				params:  nil,
				headers: []string{},
			},
			wantErr: false,
			want: expects{
				method:  "GET",
				u:       "https://api.github.com/repos/octocat/spoon-knife",
				body:    "",
				headers: "Accept: */*\r\n",
			},
