			wants: editItemOpts{
				number: 456,
				itemID: "123",
			},
		},
		{
			name: "number with floating point value",
			cli:  "--number 123.45 --id 123",
			wants: editItemOpts{
				number: 123.45,
				itemID: "123",
			},
		},
		{
			name: "number zero",
			cli:  "--number 0 --id 123",
			wants: editItemOpts{
				number: 0,
				itemID: "123",
			},
		},
