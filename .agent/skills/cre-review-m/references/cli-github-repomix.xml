			}
			require.NoError(t, err)
			require.Equal(t, tt.wantsOpts.RecurseSubmodules, spiedOpts.RecurseSubmodules)
			require.Equal(t, tt.wantsOpts.Force, spiedOpts.Force)
			require.Equal(t, tt.wantsOpts.Detach, spiedOpts.Detach)
