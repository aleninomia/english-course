func TestManager_Dispatch(t *testing.T) {
	dataDir := t.TempDir()
	updateDir := t.TempDir()
	extDir := filepath.Join(dataDir, "extensions", "gh-hello")
	extPath := filepath.Join(dataDir, "extensions", "gh-hello", "gh-hello")
