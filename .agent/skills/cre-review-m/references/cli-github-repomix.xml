	} else {
		host, _ = cfg.Authentication().DefaultHost()
	}

	for _, option := range config.Options {
		fmt.Fprintf(opts.IO.Out, "%s=%s\n", option.Key, option.CurrentValue(cfg, host))
	}

	return nil
