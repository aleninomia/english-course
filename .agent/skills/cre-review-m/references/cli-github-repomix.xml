			name: "Enterprise GraphQL",
			args: args{
				client:  &httpClient,
				host:    "example.org",
				method:  "POST",
				p:       "graphql",
				params:  map[string]interface{}{},
				headers: []string{},
			},
			wantErr: false,
			want: expects{
