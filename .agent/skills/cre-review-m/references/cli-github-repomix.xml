				SelectorArg: "",
				UseColor:    false,
			},
		},
		{
			name:    "no argument with --repo override",
			args:    "-R owner/repo",
			isTTY:   true,
			wantErr: "argument required when using the `--repo` flag",
		},
		{
			name:  "exclude single pattern",
			args:  "--exclude '*.yml'",
			isTTY: true,
			want: DiffOptions{
				SelectorArg: "",
				UseColor:    true,
				Exclude:     []string{"*.yml"},
			},
		},
		{
			name:  "exclude multiple patterns",
