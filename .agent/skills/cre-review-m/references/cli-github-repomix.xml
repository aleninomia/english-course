				reg.Register(
					httpmock.REST("GET", "repos/OWNER/REPO/keys"),
					httpmock.StringResponse(fmt.Sprintf(`[
						{
							"id": 1234,
							"key": "ssh-rsa AAAABbBB123",
							"title": "Mac",
							"created_at": "%[1]s",
							"read_only": false
						},
