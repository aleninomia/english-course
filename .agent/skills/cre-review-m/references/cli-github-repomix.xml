	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			destDir := t.TempDir()
			reg := &httpmock.Registry{}
			defer reg.Verify(t)
			tt.stubs(reg)
			client := api.NewClientFromHTTP(&http.Client{Transport: reg})
			opts := &Options{
				Host:   "github.com",
				Owner:  "monalisa",
				Repo:   "octocat-skills",
				Ref:    "v1.0",
				SHA:    "commit123",
				Client: client,
