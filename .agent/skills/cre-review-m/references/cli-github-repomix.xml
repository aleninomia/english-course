			verify: func(t *testing.T, destDir string) {
				t.Helper()
				_, err := os.Stat(filepath.Join(destDir, "..", "etc", "passwd"))
				assert.True(t, os.IsNotExist(err), "traversal path should not be written")
			},
		},
