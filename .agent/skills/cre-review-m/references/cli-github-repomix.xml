func (p *huhPrompter) Password(prompt string) (string, error) {
	form, result := p.buildPasswordForm(prompt)
	err := p.runForm(form)
	if err != nil {
		return "", err
	}
	return *result, nil
}

func (p *huhPrompter) buildConfirmForm(prompt string, defaultValue bool) (*huh.Form, *bool) {
