									"publishedAt": "%[1]s"
								}
							]
						} } } }`, createdAt.Format(time.RFC3339)),
					func(s string, m map[string]interface{}) {
						// Assert "immutable" field is NOT requested
						assert.NotRegexp(t, `\bimmutable\b`, s)
					},
				),
			)
		}
	}

	tests := []struct {
		name       string
		isTTY      bool
		opts       ListOptions
