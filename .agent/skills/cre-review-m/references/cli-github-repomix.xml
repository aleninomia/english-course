	flags = c.NonInheritedFlags()
	buf = new(bytes.Buffer)
	flags.SetOutput(buf)

	if err := printFlagsHTML(buf, flags); err != nil {
		t.Fatalf("printFlagsHTML failed: %s", err.Error())
	}
	output = buf.String()

	checkStringContains(t, output, "(default [apples,oranges])")
}
