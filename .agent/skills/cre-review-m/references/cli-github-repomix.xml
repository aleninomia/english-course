							"has_wiki":           true,
						}, payload)
					}))
			},
			wantRepo: "https://github.com/snacks-inc/crisps",
		},
		{
			name:     "create with license and gitignore for team",
			hostname: "github.com",
			input: repoCreateInput{
				Name:              "crisps",
				Visibility:        "internal",
				OwnerLogin:        "snacks-inc",
