		{
			// TODO: immutableReleaseFullSupport
			// Delete this when covered GHES versions support immutable releases.
			name:  "machine-readable, immutable releases unsupported",
			isTTY: false,
			opts: ListOptions{
				Detector:     &fd.DisabledDetectorMock{},
